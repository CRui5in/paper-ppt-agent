# Server
HOST=0.0.0.0
PORT=8000

# Default LLM provider (openai / deepseek / anthropic / gemini)
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-5.4

# API Keys (provide at least one)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Paper parsing (optional: MinerU for high-fidelity PDF parsing)
MINERU_API_KEY=
MINERU_API_URL=

# Image generation (optional)
IMAGE_BACKEND=gemini

# URL sources use a locally installed Playwright Chromium browser.
URL_FETCH_TIMEOUT=45
URL_BROWSER_CONCURRENCY=2
URL_BROWSER_MIN_WAIT_SECONDS=4
URL_BROWSER_SETTLE_SECONDS=8
